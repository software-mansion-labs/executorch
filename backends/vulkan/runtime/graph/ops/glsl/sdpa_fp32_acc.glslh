/*
 * iter136 fp32 attention accumulators.
 *
 * Drop-in replacement for the linear_fp_output_tile.glslh /
 * linear_fp_output_tile_fp_compute.glslh / gemma_sdpa_fp_attn_weight_tile_store.glslh
 * helpers used by the gemma SDPA compute shaders.
 *
 * Storage (Q, K, V, attn-weights, attn-output) stays at DTYPE
 * (typically fp16). Internal accumulator + masking + reductions run in
 * fp32 to defeat fp16 cumulative drift over head_dim ~512 dot products
 * and over the cooperative tree-reduction.
 *
 * Existing helpers in linear_fp_output_tile{,_fp_compute,_store}.glslh and
 * gemma_sdpa_fp_attn_weight_tile_store.glslh are NOT modified, so any
 * shader that doesn't include this file behaves exactly as before.
 *
 * Macro Settings expected by callers:
 *   - TILE_M, TILE_N4, TILE_K4
 *   - VEC4_T, T (storage types from DTYPE)
 *   - HAS_MASK, OUTPUT_BUFFER, MASK_BUFFER (optional)
 */

#ifndef SDPA_FP32_ACC_GLSLH
#define SDPA_FP32_ACC_GLSLH

#extension GL_EXT_control_flow_attributes : require

#include "linear_common.glslh"
#include "linear_fp_input_tile.glslh"
#include "linear_fp_weight_tile.glslh"

struct SDPAFPOutTileFP32 {
  vec4 data[TILE_M][TILE_N4];
};

void fp32_initialize(out SDPAFPOutTileFP32 out_tile) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      out_tile.data[m][n4] = vec4(0);
    }
  }
}

void fp32_set_out_tile_to_vec(
    out SDPAFPOutTileFP32 tile, const vec4 v) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      tile.data[m][n4] = v;
    }
  }
}

void fp32_accumulate_with_fp_weight(
    inout SDPAFPOutTileFP32 accum,
    FPInputTile in_tile,
    FPWeightTile w_tile) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      [[unroll]] for (int k4 = 0; k4 < TILE_K4; ++k4) {
        accum.data[m][n4] =
            fma(vec4(in_tile.data[m][k4][0]),
                vec4(w_tile.data[mul_4(k4)][n4]),
                accum.data[m][n4]);

        accum.data[m][n4] =
            fma(vec4(in_tile.data[m][k4][1]),
                vec4(w_tile.data[mul_4(k4) + 1][n4]),
                accum.data[m][n4]);

        accum.data[m][n4] =
            fma(vec4(in_tile.data[m][k4][2]),
                vec4(w_tile.data[mul_4(k4) + 2][n4]),
                accum.data[m][n4]);

        accum.data[m][n4] =
            fma(vec4(in_tile.data[m][k4][3]),
                vec4(w_tile.data[mul_4(k4) + 3][n4]),
                accum.data[m][n4]);
      }
    }
  }
}

void fp32_accumulate_out_tile_with_out_tile(
    inout SDPAFPOutTileFP32 accum,
    const SDPAFPOutTileFP32 other) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      accum.data[m][n4] = accum.data[m][n4] + other.data[m][n4];
    }
  }
}

#endif // SDPA_FP32_ACC_GLSLH
