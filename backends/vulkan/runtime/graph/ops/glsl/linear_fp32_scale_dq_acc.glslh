/*
 * iter145 fp32 weight-scale variant of linear_fp32_dq_acc.glslh.
 * Mirrors fp32_accumulate_out_tile_with_int_accum_from_int4_weights, but with
 * weight_scales tile at fp32 precision (see linear_fp32_scale_acc.glslh).
 */

#ifndef LINEAR_FP32_SCALE_DQ_ACC_GLSLH
#define LINEAR_FP32_SCALE_DQ_ACC_GLSLH

#extension GL_EXT_control_flow_attributes : require

#include "linear_fp32_acc.glslh"
#include "linear_fp32_scale_acc.glslh"
#include "linear_int8_input_scales_zps.glslh"
#include "linear_int_accumulator.glslh"
#include "linear_int_per_in_channel_params.glslh"
#include "linear_int_per_out_channel_params.glslh"

void fp32_scale_accumulate_out_tile_with_int_accum_from_int4_weights(
    inout LinearFPOutTileFP32 out_tile,
    const Int32Accum accum,
    const IntPerInChannelParams input_sums,
    const Int8InputScales input_scales,
    const Int8InputZeroPoints input_zps,
    const IntPerOutChannelParams weight_sums,
    const FPPerOutChannelScalesFP32 weight_scales,
    const int group_size) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    const int m4 = div_4(m);
    const int m4i = mod_4(m);

    float input_scale_m = input_scales.data[m4][m4i];
    int input_zp_m = input_zps.data[m4][m4i];
    int input_sum_m = input_sums.data[m4][m4i];

    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      ivec4 accum_adjusted = accum.data[m][n4] -
          (weight_sums.data[n4] + 8 * group_size) * input_zp_m +
          mul_8(group_size * input_zp_m - input_sum_m);

      out_tile.data[m][n4] =
          fma(vec4(accum_adjusted),
              input_scale_m * weight_scales.data[n4],
              out_tile.data[m][n4]);
    }
  }
}

#endif // LINEAR_FP32_SCALE_DQ_ACC_GLSLH
