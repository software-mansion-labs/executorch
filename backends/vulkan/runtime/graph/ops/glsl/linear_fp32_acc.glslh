/*
 * iter137 fp32 linear accumulators.
 *
 * Drop-in replacement for the linear_fp_output_tile.glslh /
 * linear_fp_output_tile_fp_int4_compute.glslh /
 * linear_fp_output_tile_int8_int4_compute.glslh /
 * linear_fp_output_tile_store.glslh helpers used by the q4gsw and
 * dq8ca_q4gsw matmul shaders.
 *
 * Storage (input/output/weights) stays at DTYPE (typically fp16). Internal
 * accumulator runs in fp32 to defeat fp16 cumulative drift over k-dim ~1536
 * dot products and over the cooperative tree-reduction. Scales/zeros are
 * upcast to fp32 at the use site in the inner loop.
 *
 * Existing helpers in linear_fp_output_tile{,_fp_int4_compute,_int8_int4_compute,_store}.glslh
 * are NOT modified, so any shader that doesn't include this file behaves
 * exactly as before.
 *
 * Macro Settings expected by callers:
 *   - TILE_M, TILE_N4, TILE_K4, TILE_N8
 *   - VEC4_T, T (storage types from DTYPE)
 *   - OUTPUT_BUFFER (optional)
 */

#ifndef LINEAR_FP32_ACC_GLSLH
#define LINEAR_FP32_ACC_GLSLH

#extension GL_EXT_control_flow_attributes : require

#include "linear_common.glslh"
#include "linear_fp_input_tile.glslh"
#include "linear_fp_output_tile.glslh"
#include "linear_fp_per_out_channel_params.glslh"
#include "linear_int4_weight_tile.glslh"

// fp32 accumulator output tile.
struct LinearFPOutTileFP32 {
  vec4 data[TILE_M][TILE_N4];
};

void fp32_initialize(out LinearFPOutTileFP32 out_tile) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      out_tile.data[m][n4] = vec4(0);
    }
  }
}

// Mirrors fp_accumulate_with_int4_weight, but accumulates in fp32.
// Inputs (in_tile, scales, zeros) are upcast to fp32 at use sites.
void fp32_fp_accumulate_with_int4_weight(
    inout LinearFPOutTileFP32 accum,
    FPInputTile in_tile,
    Int4WeightTile w_tile,
    FPPerOutChannelParams scales_tile,
    FPPerOutChannelParams zeros_tile) {
  vec4 weight_texels[2];
  [[unroll]] for (int n8 = 0; n8 < TILE_N8; ++n8) {
    const int n4 = mul_2(n8);
    [[unroll]] for (int k4 = 0; k4 < TILE_K4; ++k4) {
      [[unroll]] for (int k4i = 0; k4i < 4; ++k4i) {
        const int base_col_1 = mul_2(k4i);
        const int base_col_2 = base_col_1 + 1;
        weight_texels[0] = vec4(
            float(((w_tile.data[k4][n8][0] >> (4 * base_col_1)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][1] >> (4 * base_col_1)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][2] >> (4 * base_col_1)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][3] >> (4 * base_col_1)) & 0xF) - 8));
        weight_texels[1] = vec4(
            float(((w_tile.data[k4][n8][0] >> (4 * base_col_2)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][1] >> (4 * base_col_2)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][2] >> (4 * base_col_2)) & 0xF) - 8),
            float(((w_tile.data[k4][n8][3] >> (4 * base_col_2)) & 0xF) - 8));

        weight_texels[0] = fma(
            weight_texels[0],
            vec4(scales_tile.data[n4]),
            vec4(zeros_tile.data[n4]));
        weight_texels[1] = fma(
            weight_texels[1],
            vec4(scales_tile.data[n4 + 1]),
            vec4(zeros_tile.data[n4 + 1]));

        [[unroll]] for (int m = 0; m < TILE_M; ++m) {
          accum.data[m][n4] =
              fma(vec4(in_tile.data[m][k4][k4i]),
                  weight_texels[0],
                  accum.data[m][n4]);
          accum.data[m][n4 + 1] =
              fma(vec4(in_tile.data[m][k4][k4i]),
                  weight_texels[1],
                  accum.data[m][n4 + 1]);
        }
      }
    }
  }
}

void fp32_accumulate_out_tile_with_out_tile(
    inout LinearFPOutTileFP32 accum,
    const LinearFPOutTileFP32 other) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      accum.data[m][n4] = accum.data[m][n4] + other.data[m][n4];
    }
  }
}

// Storage helpers.
void fp32_write_output_x4(
    const vec4 out_texel,
    const int n4,
    const int m,
    const int N4) {
#ifdef OUTPUT_BUFFER
  t_output[m * N4 + n4] = VEC4_T(out_texel);
#else
  imageStore(t_output, ivec3(n4, m, 0), VEC4_T(out_texel));
#endif
}

void fp32_write_output_tile_with_checks(
    const LinearFPOutTileFP32 out_tile,
    const int n4_start,
    const int m_start,
    const int N4,
    const int M) {
  [[unroll]] for (int m = 0; m < TILE_M; ++m) {
    [[unroll]] for (int n4 = 0; n4 < TILE_N4; ++n4) {
      if (m_start + m < M && n4_start + n4 < N4) {
        fp32_write_output_x4(
            out_tile.data[m][n4], n4_start + n4, m_start + m, N4);
      }
    }
  }
}

#endif // LINEAR_FP32_ACC_GLSLH
