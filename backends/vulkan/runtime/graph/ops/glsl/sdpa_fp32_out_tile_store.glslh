/*
 * iter136 fp32-attn-acc helpers for the SDPA output tile store.
 * Mirrors sdpa_fp_out_tile_store.glslh but takes SDPAFPOutTileFP32.
 * Cast back to VEC4_T (DTYPE) at the store boundary.
 */

#ifndef SDPA_FP32_OUT_TILE_STORE_GLSLH
#define SDPA_FP32_OUT_TILE_STORE_GLSLH

#extension GL_EXT_control_flow_attributes : require

#include "sdpa_fp32_acc.glslh"

void store_out_d4_fp32(
    const vec4 out_fp32,
    const int d4,
    const int q_h,
    const int s,
    const int D4,
    const int Q_H,
    const int S) {
#ifdef OUTPUT_BUFFER
  t_output[(s * Q_H * D4) + (q_h * D4) + d4] = VEC4_T(out_fp32);
#else
  imageStore(t_output, ivec3(d4, q_h, s), VEC4_T(out_fp32));
#endif
}

void fp32_store_sdpa_out_tile_with_checks(
    const SDPAFPOutTileFP32 tile,
    const int d4_start,
    const int s_start,
    const int q_h,
    const int D4,
    const int S,
    const int Q_H) {
  [[unroll]] for (int s = 0; s < TILE_M; ++s) {
    [[unroll]] for (int d4 = 0; d4 < TILE_N4; ++d4) {
      if (d4_start + d4 < D4 && s_start + s < S) {
        store_out_d4_fp32(
            tile.data[s][d4], d4_start + d4, q_h, s_start + s, D4, Q_H, S);
      }
    }
  }
}

#endif // SDPA_FP32_OUT_TILE_STORE_GLSLH
