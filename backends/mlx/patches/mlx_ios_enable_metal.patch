diff --git a/CMakeLists.txt b/CMakeLists.txt
index 041a476c..26c09220 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -70,6 +70,9 @@ if(${CMAKE_SYSTEM_NAME} MATCHES "Darwin")
       message(WARNING "Building for x86_64 arch is not officially supported.")
     endif()
   endif()
+elseif(${CMAKE_SYSTEM_NAME} MATCHES "iOS|tvOS|watchOS|visionOS")
+  # Apple non-macOS platforms (iOS, etc.) have Metal — keep the GPU backend on.
+  # Upstream MLX assumes Metal is macOS-only and would disable it here.
 else()
   set(MLX_BUILD_METAL OFF)
 endif()
@@ -190,16 +193,31 @@ if(MLX_BUILD_METAL)
   set(METAL_CPP_URL
       https://developer.apple.com/metal/cpp/files/metal-cpp_26.zip)
 
-  if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "")
+  # On macOS, enforce the deployment-target floor. On iOS (and other Apple
+  # platforms) CMAKE_OSX_DEPLOYMENT_TARGET carries the macOS-compat floor (e.g.
+  # 12.0) while the real platform min is DEPLOYMENT_TARGET (>= 17.0), so skip the
+  # macOS assert and the macosx version-min flag there.
+  # Metal SDK used to probe the Metal language version. On iOS we must probe the
+  # iphoneos SDK at the iOS deployment target so version-gated kernels (e.g.
+  # fence, which needs Metal 3.2 features unavailable at iOS 17) are correctly
+  # excluded. On macOS, keep the original macosx probe.
+  set(MLX_PROBE_SDK "macosx")
+  if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL ""
+     AND CMAKE_SYSTEM_NAME STREQUAL "Darwin")
     if(${CMAKE_OSX_DEPLOYMENT_TARGET} LESS 14.0)
       message(FATAL_ERROR "MLX requires macOS >= 14.0")
     endif()
     set(XCRUN_FLAGS "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
+  elseif(CMAKE_SYSTEM_NAME MATCHES "iOS|tvOS|watchOS|visionOS")
+    set(MLX_PROBE_SDK "iphoneos")
+    if(NOT DEPLOYMENT_TARGET STREQUAL "")
+      set(XCRUN_FLAGS "-mios-version-min=${DEPLOYMENT_TARGET}")
+    endif()
   endif()
   execute_process(
     COMMAND
       zsh "-c"
-      "echo \"__METAL_VERSION__\" | xcrun -sdk macosx metal ${XCRUN_FLAGS} -E -x metal -P - | tail -1 | tr -d '\n'"
+      "echo \"__METAL_VERSION__\" | xcrun -sdk ${MLX_PROBE_SDK} metal ${XCRUN_FLAGS} -E -x metal -P - | tail -1 | tr -d '\n'"
     OUTPUT_VARIABLE MLX_METAL_VERSION COMMAND_ERROR_IS_FATAL ANY)
   FetchContent_Declare(metal_cpp URL ${METAL_CPP_URL})
   FetchContent_MakeAvailable(metal_cpp)
